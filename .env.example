# ────────────────────────────────────────────────────────────
# AdIntel — environment variables
# Copy this to .env and fill in your keys.
# ────────────────────────────────────────────────────────────

# Google AI Studio API key (Gemini + Nano Banana / Imagen)
# Get one free at: https://aistudio.google.com/apikey


# Model IDs (defaults are sane; override if you want)
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_VISION_MODEL=gemini-flash-latest
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ─── Meta Ad Library API ────────────────────────────────────
# Requires a Meta app + user access token with `ads_read` scope.
# https://www.facebook.com/ads/library/api/
# For hackathon MVP we ship with a mock client that returns
# realistic sample data; set USE_META_STUB=false when you plug real creds.
META_ACCESS_TOKEN=
USE_META_STUB=true

# ─── Data source (which backend IngestAgent uses) ───────────────
# One of: meta_stub | bq_political | meta_live | bq_kaggle | bq_kaggle_transcripts | curated_visual
# * meta_stub             — deterministic synthetic ads, zero-setup fallback
# * bq_political          — queries bigquery-public-data.google_political_ads (real data,
#                            needs GCP_PROJECT_ID + `gcloud auth application-default login`)
# * meta_live             — hits Meta Ad Library v18 API (needs META_ACCESS_TOKEN above,
#                            blocked pending Meta ID/location verification)
# * bq_kaggle             — queries your own BQ dataset loaded from Kaggle, generic
#                            tolerant column-name mapper (needs BQ_KAGGLE_TABLE below)
# * bq_kaggle_transcripts — queries the "Advertisement Transcripts from Various
#                            Industries" Kaggle dataset (kevinhartman0), exact schema
#                            mapper. Real commercial ad copy, 1936 rows, 1348 brands.
#                            Uses BQ_KAGGLE_TABLE below. No delivery dates in this
#                            dataset -- also set BQ_SKIP_LONGEVITY_FILTER=true.
# * curated_visual        — reads the local, permissioned visual corpus in
#                            demo_ads.json; see DEMO_DATASET.md. Use this for a
#                            reliable, no-network demo with real image assets.
# Current default: bq_kaggle_transcripts, pointed at the live BigQuery project
# (see BQ_KAGGLE_TABLE / GCP_PROJECT_ID below).
DATA_SOURCE=bq_kaggle_transcripts

# Used when DATA_SOURCE=curated_visual. Paths are relative to the project root.
CURATED_VISUAL_FILE=demo_ads.json
CURATED_VISUAL_ASSET_DIR=demo_assets

# When DATA_SOURCE=bq_political, this table is queried:
BQ_POLITICAL_TABLE=bigquery-public-data.google_political_ads.creative_stats

# When DATA_SOURCE=bq_kaggle or bq_kaggle_transcripts, point at your uploaded table.
# Both "project.dataset.table" and "project:dataset.table" (BQ console/CLI
# style) are accepted -- the client normalizes colons to dots internally.
#   e.g.  my-hackathon-project.commercial_ads.advertisement_transcripts
BQ_KAGGLE_TABLE=project-47457978-49f4-4e71-9a0:commercial_ads.ad_transcripts

# Per-advertiser row cap on BQ queries (keeps free-tier usage sane)
BQ_LIMIT_PER_BRAND=50

# Set true ONLY for data sources with no delivery-date columns (currently
# bq_kaggle_transcripts). Skips LongevityAgent's 90-day filter and treats
# every fetched ad as a winner instead -- otherwise every ad would compute
# days_running=0 and get silently filtered into an empty result.
BQ_SKIP_LONGEVITY_FILTER=true

# ─── Firebase / Firestore (optional in MVP) ────────────────
# Leave blank to use in-memory storage.
GCP_PROJECT_ID=project-47457978-49f4-4e71-9a0
FIRESTORE_COLLECTION=adintel_analyses
FIREBASE_STORAGE_BUCKET=

# --- App ----------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Orchestration backend ------------------------------------
# true  = drive the pipeline through Google ADK's SequentialAgent
#         (agents/adk_pipeline.py) - the canonical multi-agent
#         architecture for hackathon judging.
# false = use the plain functional Orchestrator (agents/orchestrator.py)
#         instead. Instant fallback if ADK misbehaves during a live demo;
#         both paths run the identical six agents.
ADK_ENABLED=true
